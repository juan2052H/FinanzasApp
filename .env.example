FINANZAS_DATA_DIR=
FINANZAS_DEMO_MODE=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:0/callback

# Backend/API
FINANZAS_API_ENABLED=false
FINANZAS_API_BASE_URL=http://localhost:8080
SPRING_PROFILES_ACTIVE=dev
POSTGRES_DB=finanzas
POSTGRES_USER=finanzas
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
BACKEND_PORT=8080
FINANZAS_DB_URL=jdbc:postgresql://localhost:5432/finanzas
FINANZAS_JWT_SECRET=change-this-dev-secret-at-least-32-chars
FINANZAS_ACCESS_TOKEN_MINUTES=15
FINANZAS_REFRESH_TOKEN_DAYS=14
FINANZAS_STORAGE_DIR=./storage
FINANZAS_MAX_FILE_SIZE=5MB
FINANZAS_MAX_REQUEST_SIZE=6MB
FINANZAS_DOMAIN=finanzas.example.com
